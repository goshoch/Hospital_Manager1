@model IEnumerable<Hospital_Manager.ViewModels.Doctor.DoctorIndexViewModel>

@{
    ViewData["Title"] = "Doctors";
}

<h1>Doctors</h1>

<p>
    <a asp-action="Create">Create New Doctor</a>
</p>
<div class="row mb-3">
    <div class="col-md-3">
        <label>Doctor Name</label>
        <input type="text" id="search" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-3">
        <label>Specialty</label>
        <input type="text" id="specialty" class="form-control" placeholder="Search by specialty..." />
    </div>
    <div class="col-md-3">
        <label>Sort By</label>
        <select id="sortOrder" class="form-control">
            <option value="name_asc">Name A-Z</option>
            <option value="name_desc">Name Z-A</option>
            <option value="specialty">Specialty A-Z</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        button type="button" id="clearFilters" class="btn btn-secondary">Clear Filters</button>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Specialty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HospitalName)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody id="doctorsTable">
        @foreach (var doctor in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => doctor.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => doctor.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => doctor.Specialty)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => doctor.HospitalName)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@doctor.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@doctor.Id">
                        Details
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@doctor.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>